{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg_dark": "{{ colors.surface.dark.hex }}",
    "bg_light": "{{ colors.surface.light.hex }}",
    "panel_dark": "{{ colors.surface_container.dark.hex }}",
    "panel_light": "{{ colors.surface_container.light.hex }}",
    "element_dark": "{{ colors.surface_container_high.dark.hex }}",
    "element_light": "{{ colors.surface_container_high.light.hex }}",

    "text_dark": "{{ colors.on_surface.dark.hex }}",
    "text_light": "{{ colors.on_surface.light.hex }}",
    "muted_dark": "{{ colors.on_surface_variant.dark.hex }}",
    "muted_light": "{{ colors.on_surface_variant.light.hex }}",

    "border_dark": "{{ colors.outline_variant.dark.hex }}",
    "border_light": "{{ colors.outline_variant.light.hex }}",
    "border_subtle_dark": "{{ colors.surface_container_highest.dark.hex }}",
    "border_subtle_light": "{{ colors.surface_container_highest.light.hex }}",

    "primary_dark": "{{ colors.primary.dark.hex }}",
    "primary_light": "{{ colors.primary.light.hex }}",
    "secondary_dark": "{{ colors.secondary.dark.hex }}",
    "secondary_light": "{{ colors.secondary.light.hex }}",
    "accent_dark": "{{ colors.tertiary.dark.hex }}",
    "accent_light": "{{ colors.tertiary.light.hex }}",

    "dim_dark": "{{ colors.outline.dark.hex }}",
    "dim_light": "{{ colors.outline.light.hex }}",

    "red_dark": "{{ "#e35b60" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "red_light": "{{ "#e35b60" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 42.0 }}",
    "green_dark": "{{ "#6bbf72" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "green_light": "{{ "#6bbf72" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 32.0 }}",
    "yellow_dark": "{{ "#d9a441" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "yellow_light": "{{ "#d9a441" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 34.0 }}",
    "orange_dark": "{{ "#e0854b" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "orange_light": "{{ "#e0854b" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 38.0 }}",
    "blue_dark": "{{ "#6fa8ff" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "blue_light": "{{ "#6fa8ff" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 45.0 }}",
    "magenta_dark": "{{ "#c88ce0" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "magenta_light": "{{ "#c88ce0" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 42.0 }}",
    "cyan_dark": "{{ "#5cbcc4" | to_color | harmonize: {{ colors.source_color.default.hex }} }}",
    "cyan_light": "{{ "#5cbcc4" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 34.0 }}",

    "green_bg_dark": "{{ "#6bbf72" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 15.0 }}",
    "green_bg_light": "{{ "#6bbf72" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 90.0 }}",
    "red_bg_dark": "{{ "#e35b60" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 15.0 }}",
    "red_bg_light": "{{ "#e35b60" | to_color | harmonize: {{ colors.source_color.default.hex }} | set_lightness: 90.0 }}"
  },
  "theme": {
    "primary": { "dark": "primary_dark", "light": "primary_light" },
    "secondary": { "dark": "secondary_dark", "light": "secondary_light" },
    "accent": { "dark": "accent_dark", "light": "accent_light" },
    "error": { "dark": "red_dark", "light": "red_light" },
    "warning": { "dark": "yellow_dark", "light": "yellow_light" },
    "success": { "dark": "green_dark", "light": "green_light" },
    "info": { "dark": "blue_dark", "light": "blue_light" },

    "text": { "dark": "text_dark", "light": "text_light" },
    "textMuted": { "dark": "muted_dark", "light": "muted_light" },

    "background": "none",
    "backgroundPanel": { "dark": "panel_dark", "light": "panel_light" },
    "backgroundElement": { "dark": "element_dark", "light": "element_light" },

    "border": { "dark": "border_dark", "light": "border_light" },
    "borderActive": { "dark": "primary_dark", "light": "primary_light" },
    "borderSubtle": { "dark": "border_subtle_dark", "light": "border_subtle_light" },

    "diffAdded": { "dark": "green_dark", "light": "green_light" },
    "diffRemoved": { "dark": "red_dark", "light": "red_light" },
    "diffContext": { "dark": "muted_dark", "light": "muted_light" },
    "diffHunkHeader": { "dark": "muted_dark", "light": "muted_light" },
    "diffHighlightAdded": { "dark": "green_dark", "light": "green_light" },
    "diffHighlightRemoved": { "dark": "red_dark", "light": "red_light" },
    "diffAddedBg": { "dark": "green_bg_dark", "light": "green_bg_light" },
    "diffRemovedBg": { "dark": "red_bg_dark", "light": "red_bg_light" },
    "diffContextBg": { "dark": "panel_dark", "light": "panel_light" },
    "diffLineNumber": { "dark": "dim_dark", "light": "dim_light" },
    "diffAddedLineNumberBg": { "dark": "green_bg_dark", "light": "green_bg_light" },
    "diffRemovedLineNumberBg": { "dark": "red_bg_dark", "light": "red_bg_light" },

    "markdownText": { "dark": "text_dark", "light": "text_light" },
    "markdownHeading": { "dark": "primary_dark", "light": "primary_light" },
    "markdownLink": { "dark": "cyan_dark", "light": "cyan_light" },
    "markdownLinkText": { "dark": "blue_dark", "light": "blue_light" },
    "markdownCode": { "dark": "green_dark", "light": "green_light" },
    "markdownBlockQuote": { "dark": "muted_dark", "light": "muted_light" },
    "markdownEmph": { "dark": "yellow_dark", "light": "yellow_light" },
    "markdownStrong": { "dark": "primary_dark", "light": "primary_light" },
    "markdownHorizontalRule": { "dark": "border_dark", "light": "border_light" },
    "markdownListItem": { "dark": "primary_dark", "light": "primary_light" },
    "markdownListEnumeration": { "dark": "accent_dark", "light": "accent_light" },
    "markdownImage": { "dark": "cyan_dark", "light": "cyan_light" },
    "markdownImageText": { "dark": "blue_dark", "light": "blue_light" },
    "markdownCodeBlock": { "dark": "text_dark", "light": "text_light" },

    "syntaxComment": { "dark": "dim_dark", "light": "dim_light" },
    "syntaxKeyword": { "dark": "magenta_dark", "light": "magenta_light" },
    "syntaxFunction": { "dark": "blue_dark", "light": "blue_light" },
    "syntaxVariable": { "dark": "red_dark", "light": "red_light" },
    "syntaxString": { "dark": "green_dark", "light": "green_light" },
    "syntaxNumber": { "dark": "orange_dark", "light": "orange_light" },
    "syntaxType": { "dark": "yellow_dark", "light": "yellow_light" },
    "syntaxOperator": { "dark": "cyan_dark", "light": "cyan_light" },
    "syntaxPunctuation": { "dark": "muted_dark", "light": "muted_light" }
  }
}
