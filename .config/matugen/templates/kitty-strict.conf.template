# kitty theme — matugen template, STRICT variant. Rendered to
# ~/.config/kitty/themes/MatugenStrict.conf; never edit that file. Chrome is
# identical to kitty.conf.template-custom; ANSI is 100% matugen tonal palettes.

# --- Main Colors ---
background            {{ colors.surface.dark.hex }}
foreground            {{ colors.on_surface.dark.hex }}
cursor                {{ colors.on_surface.dark.hex }}
cursor_text_color     {{ colors.surface.dark.hex }}

selection_background  {{ colors.secondary_container.dark.hex }}
selection_foreground  {{ colors.on_secondary_container.dark.hex }}

# Matches color6 (cyan), the usual slot for links.
url_color             {{ palettes.tertiary._70.hex }}

# --- ANSI Colors ---
# `error` carries one slot only (spec-fixed hue, so a red wallpaper collapses it
# onto primary); yellow uses secondary. Two-slot palettes split by tone band.
color0                {{ palettes.neutral._10.hex }}
color1                {{ palettes.error._50.hex }}
color2                {{ palettes.tertiary._50.hex }}
color3                {{ palettes.secondary._50.hex }}
color4                {{ palettes.primary._50.hex }}
color5                {{ palettes.primary._80.hex }}
color6                {{ palettes.tertiary._70.hex }}
color7                {{ palettes.neutral_variant._80.hex }}

color8                {{ palettes.neutral._40.hex }}
color9                {{ palettes.error._60.hex }}
color10               {{ palettes.tertiary._60.hex }}
color11               {{ palettes.secondary._60.hex }}
color12               {{ palettes.primary._70.hex }}
color13               {{ palettes.primary._90.hex }}
color14               {{ palettes.tertiary._80.hex }}
color15               {{ palettes.neutral._95.hex }}

# --- Starship Prompt Bubbles ---
# Container + its on_* partner is a background/foreground pair, so this is the
# one place *_container belongs.
color255              {{ colors.primary_container.dark.hex }}
color254              {{ colors.primary.dark.hex }}
color253              {{ colors.secondary_container.dark.hex }}
color252              {{ colors.secondary.dark.hex }}
color251              {{ colors.tertiary_container.dark.hex }}
color250              {{ colors.tertiary.dark.hex }}
color249              {{ colors.error_container.dark.hex }}
color248              {{ colors.error.dark.hex }}

color232              {{ colors.on_primary_container.dark.hex }}
color233              {{ colors.on_primary.dark.hex }}
color234              {{ colors.on_secondary_container.dark.hex }}
color235              {{ colors.on_secondary.dark.hex }}
color236              {{ colors.on_tertiary_container.dark.hex }}
color237              {{ colors.on_tertiary.dark.hex }}
color238              {{ colors.on_error_container.dark.hex }}
color239              {{ colors.on_error.dark.hex }}
color240              {{ colors.on_surface.dark.hex }}

# Matched with unthemed light/dark
color243              {{ colors.primary.dark.hex }}
color244              {{ colors.error.dark.hex }}
color245              {{ colors.outline_variant.dark.hex }}

# --- UI Elements ---
active_tab_foreground   {{ colors.on_primary.dark.hex }}
active_tab_background   {{ colors.primary.dark.hex }}
inactive_tab_foreground {{ colors.on_surface_variant.dark.hex }}
inactive_tab_background {{ colors.surface_container_high.dark.hex }}

active_border_color     {{ colors.primary.dark.hex }}
inactive_border_color   {{ colors.outline_variant.dark.hex }}

# --- Marks ---
mark1_foreground        {{ colors.on_primary_fixed.dark.hex }}
mark1_background        {{ colors.primary_fixed.dark.hex }}
mark2_foreground        {{ colors.on_secondary_fixed.dark.hex }}
mark2_background        {{ colors.secondary_fixed.dark.hex }}
mark3_foreground        {{ colors.on_tertiary_fixed.dark.hex }}
mark3_background        {{ colors.tertiary_fixed.dark.hex }}
